# Application
APP_ENV=development
APP_NAME=Child Nutrition Intelligence Platform
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
INFERENCE_URL=http://localhost:8001

# Database
DATABASE_URL=postgresql+psycopg://cnip:cnip_dev_password@postgres:5432/cnip
POSTGRES_USER=cnip
POSTGRES_PASSWORD=cnip_dev_password
POSTGRES_DB=cnip

# Least-privilege DB roles (created by migration/bootstrap)
DB_APP_USER=cnip_app
DB_APP_PASSWORD=cnip_app_dev_password
DB_READONLY_USER=cnip_readonly
DB_READONLY_PASSWORD=cnip_readonly_dev_password

# Redis
REDIS_URL=redis://redis:6379/0

# Auth — generate unique values for any non-demo environment
JWT_SECRET=change-me-access-secret-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-dev-only
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7
ENCRYPTION_KEY=change-me-32-byte-fernet-or-hex-dev

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Model
MODEL_MODE=demo
MODEL_ARTIFACT_PATH=/artifacts/active
EMBEDDING_DIM=128

# Notifications — mock unless explicitly configured
NOTIFICATION_PROVIDER=mock
SMS_API_KEY=
EMAIL_API_KEY=

# FHIR / hospital adapters
FHIR_ENABLED=false
FHIR_BASE_URL=
FHIR_VERSION=R4
HOSPITAL_ADAPTER=mock

# Component integrations
C2_EXPLAINABILITY_URL=
C3_COUNTERFACTUAL_URL=
C4_DRIFT_URL=
INTEGRATION_MODE=mock

# Observability
LOG_LEVEL=INFO
LOG_JSON=true

# Seed
SEED_ON_START=true
